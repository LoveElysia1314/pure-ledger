  "components": [
    {
      "name": "保存按钮",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "原生实色动作按钮的浅色 token 预览；实际高度和输入状态由 Compose 决定。",
      "html": "<button class=\"ds-save\">保存</button>",
      "css": ".ds-save{min-height:48px;padding:0 24px;border:0;border-radius:12px;background:#1D6754;color:#FFFFFF;font:500 14px/20px sans-serif;font-variant-numeric:tabular-nums;cursor:pointer}.ds-save:hover{filter:brightness(.96)}.ds-save:focus-visible{outline:2px solid #1D6754;outline-offset:3px}.ds-save:active{filter:brightness(.9)}.ds-save:disabled{background:#19231E1F;color:#506057;cursor:default}"
    },
    {
      "name": "取消按钮",
      "kind": "button",
      "refersTo": "button-text",
      "description": "文字动作的浅色 token 预览，保留完整触控高度。",
      "html": "<button class=\"ds-cancel\">取消</button>",
      "css": ".ds-cancel{min-height:48px;padding:0 12px;border:0;border-radius:12px;background:transparent;color:#1D6754;font:500 14px/20px sans-serif;cursor:pointer}.ds-cancel:hover{background:#1D67540A}.ds-cancel:focus-visible{outline:2px solid #1D6754;outline-offset:2px}.ds-cancel:active{background:#1D675414}.ds-cancel:disabled{color:#19231E61;cursor:default}"
    },
    {
      "name": "账本选择器",
      "kind": "button",
      "refersTo": "book-menu",
      "description": "BookMenuButton 的内容宽度、色面和展开提示预览；完整账本名由原生状态语义提供。",
      "html": "<button class=\"ds-book\" aria-label=\"选择账本：日常账本\"><span>日常账本</span><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" aria-hidden=\"true\"><path d=\"m6 9 6 6 6-6\"/></svg></button>",
      "css": ".ds-book{display:inline-flex;align-items:center;gap:8px;max-width:100%;min-height:48px;padding:0 12px;border:0;border-radius:12px;background:#EDF1EE;color:#19231E;font:500 15px/22px sans-serif;cursor:pointer}.ds-book span{overflow:hidden;white-space:nowrap;text-overflow:ellipsis}.ds-book svg{width:16px;height:16px;flex-shrink:0}.ds-book:hover{filter:brightness(.98)}.ds-book:focus-visible{outline:2px solid #718078;outline-offset:2px}.ds-book:active{filter:brightness(.94)}"
    },
    {
      "name": "期间选择器",
      "kind": "button",
      "refersTo": "period-selector",
      "description": "SelectorButton 期间版本的两行容量与高位色面预览；原生目标高度为 48dp。",
      "html": "<button class=\"ds-period\" aria-label=\"选择期间：2026年11月\"><span>2026年11月</span><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" aria-hidden=\"true\"><path d=\"m6 9 6 6 6-6\"/></svg></button>",
      "css": ".ds-period{display:flex;align-items:center;gap:8px;width:240px;min-height:48px;padding:4px 12px;box-sizing:border-box;border:0;border-radius:12px;background:#E8EDE9;color:#19231E;font:500 15px/20px sans-serif;font-variant-numeric:tabular-nums;cursor:pointer}.ds-period span{flex:1;text-align:left;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden}.ds-period svg{width:16px;height:16px;flex-shrink:0}.ds-period:hover{filter:brightness(.98)}.ds-period:focus-visible{outline:2px solid #718078;outline-offset:2px}.ds-period:active{filter:brightness(.94)}"
    },
    {
      "name": "目录页签",
      "kind": "nav",
      "refersTo": "ledger-tabs",
      "description": "LedgerTabs 用于目录分组，当前项使用底部指示线。",
      "html": "<nav class=\"ds-tabs\" role=\"tablist\" aria-label=\"目录分组\"><button role=\"tab\" aria-selected=\"true\">启用</button><button role=\"tab\" aria-selected=\"false\">隐藏</button></nav>",
      "css": ".ds-tabs{display:flex;width:320px;max-width:100%}.ds-tabs button{position:relative;flex:1;min-height:50px;padding:10px 8px 12px;border:0;background:transparent;color:#506057;font:500 15px/22px sans-serif;cursor:pointer}.ds-tabs button[aria-selected=\"true\"]{font-weight:600;color:#1D6754}.ds-tabs button[aria-selected=\"true\"]:after{content:\"\";position:absolute;bottom:0;left:27.5%;width:45%;height:2px;background:#1D6754;border-radius:8px}.ds-tabs button:hover{background:#1D67540A}.ds-tabs button:focus-visible{outline:2px solid #1D6754;outline-offset:-2px}.ds-tabs button:active{background:#1D675414}"
    },
    {
      "name": "统计分析切换",
      "kind": "nav",
      "refersTo": "statistics-segment-selected",
      "description": "StatisticsControls 的分段轨道；可见选中色面高 32dp，触控范围至少 48dp。",
      "html": "<div class=\"ds-stats\" role=\"tablist\" aria-label=\"统计分析\"><button role=\"tab\" aria-selected=\"true\">分类占比</button><button role=\"tab\" aria-selected=\"false\">收支变化</button></div>",
      "css": ".ds-stats{display:flex;gap:0;background:linear-gradient(transparent 6px,#EDF1EE 6px,#EDF1EE calc(100% - 6px),transparent calc(100% - 6px));border-radius:10px}.ds-stats button{min-height:48px;padding:12px 10px;border:0;border-radius:8px;background:transparent;color:#506057;font:500 14px/20px sans-serif;cursor:pointer}.ds-stats button[aria-selected=\"true\"]{background:#DCEFE5;background-clip:padding-box;border:8px solid transparent;padding:4px 2px;color:#174736}.ds-stats button:hover{color:#1D6754}.ds-stats button:focus-visible{outline:2px solid #1D6754;outline-offset:0}"
    },
    {
      "name": "图表与列表切换",
      "kind": "nav",
      "refersTo": "view-switch-selected",
      "description": "StatisticsDisplaySwitch 与分析维度共用分段样式，两种分析共用展示偏好，每项保留 48dp 触控范围。",
      "html": "<div class=\"ds-view\" role=\"tablist\" aria-label=\"统计视图\"><button role=\"tab\" aria-label=\"图表\" aria-selected=\"true\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" aria-hidden=\"true\"><path d=\"M12 3v9h9A9 9 0 1 1 12 3Z\"/><path d=\"M15 3.5A9 9 0 0 1 20.5 9H15Z\"/></svg></button><button role=\"tab\" aria-label=\"列表\" aria-selected=\"false\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" aria-hidden=\"true\"><path d=\"M8 6h13M8 12h13M8 18h13M3 6h.01M3 12h.01M3 18h.01\"/></svg></button></div>",
      "css": ".ds-view{display:flex;width:96px;background:#EDF1EE;border-radius:10px}.ds-view button{display:grid;place-items:center;width:48px;height:48px;padding:0;border:0;border-radius:10px;background:transparent;color:#506057;cursor:pointer}.ds-view button[aria-selected=\"true\"]{background:#DCEFE5;background-clip:padding-box;border:8px solid transparent;color:#174736}.ds-view svg{width:20px;height:20px}.ds-view button:hover{background:#EDF1EE}.ds-view button[aria-selected=\"true\"]:hover{background:#E8EDE9}.ds-view button:focus-visible{outline:2px solid #1D6754;outline-offset:-2px}.ds-view button:active{filter:brightness(.94)}"
    },
    {
      "name": "录入标签",
      "kind": "chip",
      "refersTo": "entry-tag",
      "description": "EntryTags 与 EntryOption 的换行结构预览；长名称视觉最多两行，原生状态描述保留完整值。信息区优先容纳常见两行标签，溢出时由原生 EntryInformation 提供持久滚动提示。",
      "html": "<div class=\"ds-tags\"><button class=\"ds-tag\" aria-label=\"账本：日常家庭与旅行账本\"><span class=\"ds-tag-face\"><span class=\"ds-tag-label\">日常家庭与旅行账本</span><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" aria-hidden=\"true\"><path d=\"m6 9 6 6 6-6\"/></svg></span></button><button class=\"ds-tag\" aria-label=\"账户：现金\"><span class=\"ds-tag-face\"><span class=\"ds-tag-label\">现金</span><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" aria-hidden=\"true\"><path d=\"m6 9 6 6 6-6\"/></svg></span></button></div>",
      "css": ".ds-tags{display:flex;flex-wrap:wrap;gap:0 4px;max-width:320px}.ds-tag{min-height:48px;padding:6px 4px;border:0;background:transparent;cursor:pointer}.ds-tag-face{display:flex;align-items:center;gap:4px;max-width:280px;padding:6px 10px;box-sizing:border-box;border-radius:10px;background:#FFFFFF;color:#19231E;font:500 14px/20px sans-serif}.ds-tag-label{display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden;text-align:left}.ds-tag svg{width:12px;height:12px;flex-shrink:0}.ds-tag:hover .ds-tag-face{background:#EDF1EE}.ds-tag:focus-visible{outline:2px solid #1D6754;outline-offset:0;border-radius:10px}.ds-tag:active .ds-tag-face{background:#E8EDE9}"
    },
    {
      "name": "备注输入",
      "kind": "input",
      "refersTo": "entry-note",
      "description": "EntryNoteField 的容器与焦点轮廓预览；系统输入法、字号和原生选择行为由 Compose 提供。",
      "html": "<textarea class=\"ds-note\" rows=\"2\" aria-label=\"备注\" placeholder=\"备注\"></textarea>",
      "css": ".ds-note{display:block;width:300px;max-width:100%;min-height:48px;padding:10px;box-sizing:border-box;border:2px solid transparent;border-radius:12px;background:#EDF1EE;color:#19231E;font:400 15px/23px sans-serif;font-variant-numeric:tabular-nums;caret-color:#1D6754;resize:vertical}.ds-note::placeholder{color:#506057;opacity:1}.ds-note:hover{background:#E8EDE9}.ds-note:focus-visible{border-color:#1D6754;outline:0;background:#EDF1EE}.ds-note:active{caret-color:#1D6754}"
    },
    {
      "name": "候选确认面板",
      "kind": "card",
      "refersTo": "candidate-panel",
      "description": "CandidatePanel 的默认展开结构、边界与动作层级预览；CSS 阴影为示意，72%／80% 高度与键盘行为须在 Android 原生环境复核。",
      "html": "<section class=\"ds-panel\" aria-label=\"确认账单\"><header><strong>纯净记账</strong><button class=\"ds-panel-text\">收起</button></header><div class=\"ds-panel-content\"><div class=\"ds-panel-amount\"><span>金额（元）</span><strong>128.00</strong></div><p>晚餐</p><div class=\"ds-panel-categories\"><button aria-pressed=\"true\">餐饮 ✓</button><button aria-pressed=\"false\">购物</button><button aria-pressed=\"false\">交通</button></div></div><footer><button class=\"ds-panel-text\">取消</button><button class=\"ds-panel-save\">保存</button></footer></section>",
      "css": ".ds-panel{width:340px;max-width:100%;max-height:72vh;overflow:auto;box-sizing:border-box;border:1px solid #718078A6;border-radius:24px 24px 16px 16px;background:#FFFFFF;color:#19231E;box-shadow:0 4px 8px #0003;font:400 15px/23px sans-serif;font-variant-numeric:tabular-nums}.ds-panel header,.ds-panel footer{display:flex;align-items:center;gap:8px;padding:0 12px}.ds-panel header{border-bottom:.5px solid #D5DED7}.ds-panel header strong{flex:1;font:500 17px/24px sans-serif}.ds-panel button{min-height:48px;border:0;border-radius:12px;font:500 14px/20px sans-serif;cursor:pointer}.ds-panel-text{padding:0 12px;background:transparent;color:#1D6754}.ds-panel-content{padding:8px 12px}.ds-panel-amount{display:flex;align-items:baseline;gap:12px}.ds-panel-amount span{font:500 12px/18px sans-serif;color:#506057}.ds-panel-amount strong{flex:1;text-align:right;font:600 24px/30px sans-serif}.ds-panel p{margin:8px 0;padding:10px;border-radius:12px;background:#EDF1EE}.ds-panel-categories{display:flex;flex-wrap:wrap;gap:4px}.ds-panel-categories button{padding:0 12px;background:transparent;color:#506057}.ds-panel-categories button[aria-pressed=\"true\"]{background:#DCEFE5;color:#174736}.ds-panel footer{padding-bottom:4px}.ds-panel footer .ds-panel-text{flex:1}.ds-panel-save{flex:2;padding:0 20px;background:#1D6754;color:#FFFFFF}.ds-panel button:hover{filter:brightness(.96)}.ds-panel button:focus-visible{outline:2px solid #1D6754;outline-offset:2px}.ds-panel button:active{filter:brightness(.9)}"
    }
  ],
  "narrative": {
    "northStar": "账目可读，操作可达",
    "overview": "界面围绕查看账目、核对金额和完成录入组织。主标题优先显示备注，备注为空时显示交易对象；金额与标题构成第一层信息，时间、账户和分类说明交易背景。分类图标帮助定位，日期分组与期间汇总支持连续浏览。\n\n原生 Compose 控件沿用 Android 的选择、输入、返回和无障碍语义。色面、间距和对齐划分内容层级，主要操作使用主色；账务含义由文字、符号和独立语义色共同表达。",
    "keyCharacteristics": [
      "备注优先，金额完整，辅助信息可连续浏览。",
      "色面形成层级，功能边界与组内分隔强度不同。",
      "操作目标至少 48dp，阅读内容随系统字号调整。",
      "手机竖向操作，宽窗口保留列表与详情之间的连续关系。"
    ],
    "rules": [],
    "dos": [
      "**Do** 完整显示金额，按宽度换行或调整行列，并保留系统字号。",
      "**Do** 让备注、交易对象、账户和余额策略各自表达真实字段含义。",
      "**Do** 为图标和短标签保留至少 48dp 触控目标及明确的辅助状态。",
      "**Do** 用色面层级组织内容，用功能轮廓与弱分隔表达不同边界。",
      "**Do** 在手机、大字体、英文和宽窗口中复核同一流程的可达性。"
    ],
    "donts": [
      "**Don't** 为固定三列、单行或紧凑外观缩小或省略金额。",
      "**Don't** 将支出套用错误色，或仅靠颜色区分账务类型与状态。",
      "**Don't** 默认收起候选或分类，增加确认账目前的额外展开步骤。",
      "**Don't** 用小于 48dp 的点击区换取视觉密度。",
      "**Don't** 在产品中加入开发答复、验收结论、无关保证或重复版本标签。"
    ]
  }
}
